# ── MindArchitect Studio · environment template ─────────────────────────────
# Copy to `.env` and fill in. Never commit the filled-in file.

# ── database (required) ─────────────────────────────────────────────────────
# The app validates this AT IMPORT TIME, so a missing value fails at startup
# rather than on the first query.
DATABASE_URL=postgres://user:password@host:5432/mindarchitect

# `tcp` (default) or `http` for a Neon-style serverless endpoint.
# NOTE: the http driver has no interactive transactions — use the `atomic()`
# helper from server/_core/db.ts rather than db.transaction().
DB_DRIVER=tcp

# ── auth / session (required) ───────────────────────────────────────────
# Signs the session JWT. `server/_core/env.ts` validates this AT IMPORT TIME,
# so a missing value throws at startup — it is required in development too,
# not just production. Generate with: openssl rand -base64 32
JWT_SECRET=

# ── ports (dev) ─────────────────────────────────────────────────────────────
PORT=3000
API_PORT=3001

# ── LLM gateway (optional) ──────────────────────────────────────────────────
# Leave blank to run entirely on the local expert plane. The reply plane works
# either way; the difference is only which engine answers (x-ma-engine).
#
# Set ONE of these to turn on real hosted completions. The credential is read
# from the first variable that is set, in this order:
#   MINDARCHITECT_LLM_API_KEY  →  XAI_API_KEY  →  OPENAI_API_KEY  →  LLM_API_KEY
MINDARCHITECT_LLM_API_KEY=

# Optional. When unset, the base URL AND the model id are derived from whichever
# provider supplied the key. Setting one without the other is the bug that
# produces a 404 against a correct endpoint — so prefer leaving both blank.
#   OpenAI   → https://api.openai.com/v1     · gpt-4o-mini
#   xAI      → https://api.x.ai/v1           · grok-4.5
MINDARCHITECT_LLM_BASE_URL=
MINDARCHITECT_LLM_MODEL=

# Kill switch: set to 1 to force the local plane even with a key configured.
MINDARCHITECT_LLM_DISABLED=

# Timeouts, in milliseconds.
MINDARCHITECT_LLM_TIMEOUT_MS=120000
MINDARCHITECT_LLM_FIRST_TOKEN_TIMEOUT_MS=30000
MINDARCHITECT_LLM_PROBE_TIMEOUT_MS=6000

# ── platform API keys (optional) ────────────────────────────────────────────
# Default hourly budget for newly created keys. Each key can override it.
MINDARCHITECT_KEY_RATE_LIMIT_PER_HOUR=120

# ── client (optional) ───────────────────────────────────────────────────────
# Only needed when the API is not reachable at the dev proxy path.
VITE_API_BASE_URL=
