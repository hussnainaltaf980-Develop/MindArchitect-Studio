{
  "name": "webapp-fullstack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/_core/index.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-server.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@hono/trpc-server": "0.3.4",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-label": "2.1.12",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "jose": "6.2.3",
    "lucide-react": "1.25.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "wouter": "3.10.0",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
